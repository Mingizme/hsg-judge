# ============================================
# HSG Judge Platform - Environment Variables
# ============================================

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Supabase ---
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Supabase Storage Bucket ---
SUPABASE_STORAGE_BUCKET="problem-pdfs"

# --- Judge Engine (Piston API or Judge0) ---
JUDGE_API_URL="https://emkc.org/api/v2/piston"
# JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_API_KEY="your-rapidapi-key"

# --- App Config ---
PORT=4000
NODE_ENV=development

# --- Data Directory (for local ingestion) ---
DATA_DIR="./Data"

# --- Default Judge Limits ---
DEFAULT_TIME_LIMIT_MS=1000
DEFAULT_MEMORY_LIMIT_MB=256
